{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{node_modules,node_server,database,backups,uploads,img,.agents,.claude,src,scripts}/**"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
