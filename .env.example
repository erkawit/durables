# ── Database Settings (Neon Lakebase PostgreSQL) ──
# Pull automatically via `neon deploy` or `neon env pull`
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ── Neon Realtime Settings ──
NEON_REALTIME_URL=wss://YOUR_REALTIME_ENDPOINT
NEON_REALTIME_SECRET=YOUR_REALTIME_SECRET

# ── Application Settings ──
BASE_URL=https://your-project.vercel.app/
USE_DB_SESSION=true
